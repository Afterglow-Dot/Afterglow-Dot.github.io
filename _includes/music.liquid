{% comment %}
  全站背景音乐播放器
  ---------------------------------------------------------------------------
  · 音频文件：assets/audio/nagisa.mp3（4 分 10 秒，128kbps，约 4.1MB）
  · 曲目：麻枝准 — 渚（《CLANNAD》原声）
    版权归 Key / Visual Arts。站点公开托管时音频可被任何人直接下载，
    是否适合公开分发请自行判断。
  · 换曲目：新文件放进 assets/audio/，改下面 <audio> 里的文件名即可
  · 想彻底关掉：删掉 _includes/footer.liquid 末尾那行 include
  · 浏览器禁止有声自动播放，首次进入需要点一下右下角按钮
{% endcomment %}

<div class="bgm-player" id="bgm-player">
  <audio id="bgm-audio" src="{{ '/assets/audio/nagisa.mp3' | relative_url }}" loop preload="metadata"></audio>
  <button id="bgm-btn" type="button" aria-label="背景音乐" aria-pressed="false" title="背景音乐">♪</button>
</div>

<style>
  .bgm-player {
    position: fixed;
    right: 24px;
    bottom: 88px; /* 抬高一格，避开右下角的回到顶部按钮 */
    z-index: 1040;
  }
  .bgm-player[hidden] {
    display: none;
  }
  #bgm-btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    font-size: 19px;
    line-height: 1;
    color: #fff;
    background: var(--global-theme-color, #2a7ae2);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  #bgm-btn:hover,
  #bgm-btn:focus-visible {
    opacity: 1;
  }
  #bgm-btn.is-playing {
    opacity: 1;
    animation: bgm-spin 4s linear infinite;
  }
  @keyframes bgm-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #bgm-btn.is-playing {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var wrap = document.getElementById('bgm-player');
    var audio = document.getElementById('bgm-audio');
    var btn = document.getElementById('bgm-btn');
    if (!wrap || !audio || !btn) return;

    var ON_KEY = 'bgm-on';
    var TIME_KEY = 'bgm-time';
    // 隐私模式下 sessionStorage 可能不可用，降级为空实现，避免整段脚本报错
    var store = (function () {
      try {
        var s = window.sessionStorage;
        s.setItem('bgm-probe', '1');
        s.removeItem('bgm-probe');
        return s;
      } catch (e) {
        return { getItem: function () { return null; }, setItem: function () {} };
      }
    })();

    audio.volume = 0.6; // 背景音量，0~1，嫌吵就调小

    var metaReady = false;

    // 按钮默认就是可见的：iOS Safari 常忽略 preload，元数据可能要等用户点击后才加载，
    // 若把显示与否绑定在 loadedmetadata 上，iPhone 上按钮会永远不出现。
    // 因此只在真正加载失败时隐藏。
    function onMeta() {
      if (metaReady) return;
      metaReady = true;
      var t = parseFloat(store.getItem(TIME_KEY) || '0');
      if (t > 0 && audio.duration && t < audio.duration - 1) {
        audio.currentTime = t; // 换页后接着上一页的进度
      }
    }

    audio.addEventListener('error', function () {
      wrap.hidden = true;
      console.warn('[bgm] 音频加载失败，播放器已隐藏：' + (audio.currentSrc || audio.src));
    });

    function setPlaying(on) {
      btn.classList.toggle('is-playing', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      store.setItem(ON_KEY, on ? '1' : '0');
    }

    function play() {
      return audio
        .play()
        .then(function () {
          setPlaying(true);
        })
        .catch(function () {
          setPlaying(false); // 被自动播放策略拦截，等用户点按钮
        });
    }

    function resumeIfEnabled() {
      if (store.getItem(ON_KEY) === '1') play();
    }

    btn.addEventListener('click', function () {
      if (audio.paused) {
        play();
      } else {
        audio.pause();
        setPlaying(false);
      }
    });

    // 记录进度：sessionStorage 按标签页隔离，关掉标签页即清空
    audio.addEventListener('timeupdate', function () {
      store.setItem(TIME_KEY, audio.currentTime.toFixed(1));
    });
    window.addEventListener('pagehide', function () {
      if (!audio.paused) store.setItem(TIME_KEY, audio.currentTime.toFixed(1));
    });

    // 兼容两种情况：元数据已就绪（命中缓存），或稍后才加载完
    audio.addEventListener('loadedmetadata', function () {
      onMeta();
      resumeIfEnabled();
    });
    if (audio.readyState >= 1) {
      onMeta();
      resumeIfEnabled();
    }
  })();
</script>
